        "name_ar": "تكاليف تشغيلية أخرى",
        "parent_kind": "expense",
        "branch_kind": "operational_cost",
        "type_of_account": "Debit",
        "locked": false,
        "autoSystem": false,
        "canModify": true,
        "canDelete": true,
        "constraints": "Miscellaneous operational expenses"
      }
