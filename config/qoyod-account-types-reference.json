  "systemLockedAccounts": [
    "accounts_receivable",
    "bank_account",
    "accounts_payable",
    "accumulated_depreciation",
    "accumulated_amortization",
    "retained_earnings",
    "depreciation",
    "amortization"
  ],
  "validationRules": {
    "accountCodeFormat": {
      "description": "Account code format rules",
      "pattern": "alphanumeric with dashes allowed",
      "minLength": 1,
      "maxLength": 20,
      "example": "1-1-1"
    },
    "accountNameFormat": {
      "description": "Account name format rules",
      "en_name": {
        "minLength": 1,
        "maxLength": 250,
        "required": true,
        "example": "Petty Cash"
      },
      "ar_name": {
        "minLength": 1,
        "maxLength": 250,
        "required": true,
        "example": "النقدية الصغيرة"
      }
    },
    "hierarchy": {
      "maxDepth": 4,
      "rootLevel": 1,
      "description": "Maximum hierarchy depth is 4 levels"
    },
    "codeUniqueness": {
      "required": true,
      "description": "Account codes must be unique across the chart"
    },
    "parentMustExist": {
      "required": true,
      "description": "Every non-root account must have a valid parent"
    },
    "typeImmutability": {
      "required": true,
      "description": "Account type cannot be changed after creation"
    },
    "noCircularHierarchy": {
      "required": true,
      "description": "An account cannot be its own ancestor"
    }
  },
  "commonErrors": {
    "INVALID_ACCOUNT_KIND": {
      "code": "E001",
      "severity": "CRITICAL",
      "message": "Account kind '{kind}' is not in the 41 valid account types",
      "fix": "Use one of the valid account_kind values from accountKinds"
    },
    "INVALID_PARENT_KIND": {
      "code": "E002",
      "severity": "CRITICAL",
      "message": "Parent kind '{parent_kind}' is invalid",
      "fix": "Use one of: assets, liability, equity, revenue, expense"
    },
    "INVALID_BRANCH_KIND": {
      "code": "E003",
      "severity": "CRITICAL",
      "message": "Branch kind '{branch_kind}' is invalid for parent_kind '{parent_kind}'",
      "fix": "Ensure branch_kind matches the allowed values for the parent_kind"
    },
    "LOCKED_ACCOUNT_MODIFICATION": {
      "code": "E004",
      "severity": "CRITICAL",
      "message": "Cannot modify system-locked account '{kind}'",
      "fix": "System-locked accounts are managed automatically. Do not attempt to modify."
    },
    "DUPLICATE_ACCOUNT_CODE": {
      "code": "E005",
      "severity": "CRITICAL",
      "message": "Account code '{code}' already exists",
      "fix": "Use a unique account code"
    },
    "PARENT_NOT_FOUND": {
      "code": "E006",
      "severity": "CRITICAL",
      "message": "Parent account with code '{parent_code}' does not exist",
      "fix": "Ensure the parent account exists before creating child accounts"
    },
    "HIERARCHY_DEPTH_EXCEEDED": {
      "code": "E007",
      "severity": "HIGH",
      "message": "Hierarchy depth exceeds maximum of 4 levels",
      "fix": "Flatten the hierarchy to 4 levels or fewer"
    },
    "CIRCULAR_HIERARCHY": {
      "code": "E008",
      "severity": "CRITICAL",
      "message": "Circular hierarchy detected: {path}",
      "fix": "Review parent-child relationships and remove circular references"
    },
    "INVALID_CODE_FORMAT": {
      "code": "E009",
      "severity": "HIGH",
      "message": "Account code '{code}' does not match required format",
      "fix": "Use alphanumeric characters and dashes, 1-20 characters"
    },
    "MISSING_REQUIRED_FIELD": {
      "code": "E010",
      "severity": "CRITICAL",
      "message": "Required field '{field}' is missing",
      "fix": "Provide values for: en_name, ar_name, account_kind, parent_kind, branch_kind"
    },
    "PARENT_KIND_MISMATCH": {
      "code": "E011",
      "severity": "HIGH",
      "message": "account_kind '{kind}' belongs to parent_kind '{expected_parent}' but '{provided_parent}' was given",
      "fix": "Correct the parent_kind to match the account_kind"
    },
    "BRANCH_KIND_MISMATCH": {
      "code": "E012",
      "severity": "HIGH",
      "message": "branch_kind '{branch}' is not valid for account_kind '{kind}'",
      "fix": "Use the correct branch_kind for this account type"
    }
  },
